# Copy to .env (next to docker-compose.yml) and fill in what you need. .env is not in git.

# AI summary on the impact card (DeepSeek). Without it the card shows the template text.
DEEPSEEK_API_KEY=

# --- Mail alerts through a real mail server.
# Leave SMTP_HOST out (delete or comment these lines) and the alerts go to Mailpit:
# http://localhost:8025 (nothing leaves the machine).
#
# SMTP_SECURITY: starttls (port 587), ssl (port 465) or none (Mailpit, port 1025).
# Most providers only accept SMTP_FROM = the login address; Gmail needs an app password.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=alerts@example.com
SMTP_PASSWORD=
SMTP_FROM=alerts@example.com

# Public HTTPS deployment with docker-compose.https.yml. Bare hostname only.
# Caddy and all mail links use this domain; PUBLIC_URL below is overridden there.
APP_DOMAIN=www.justklaris.com

# Where recipients reach the app (links in the mail, unsubscribe link).
# Local Docker default. If your hosting platform provides TLS instead of Caddy,
# set PUBLIC_URL=https://www.justklaris.com in that platform's live service.
PUBLIC_URL=http://localhost:8080

# Only announcements published in the last N hours are mailed (no backlog after a restart)
ALERT_MAX_AGE_H=6
